{
  "manifest_version": 3,
  "name": "Binotel Port Fixer",
  "version": "1.0",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:5001/*",
    "https://panel.binotel.com/?module=gsmPorts&action=edit&companyID=*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://panel.binotel.com/?module=gsmPorts&action=edit&companyID=*"],
      "js": ["content.js"]
    }
  ]
}
